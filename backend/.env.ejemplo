# Copia este archivo a .env para desarrollo local: cp .env.ejemplo .env
# .env nunca se sube a git. En staging y producción las variables se configuran en el hosting.

# development | test | staging | production
NODE_ENV=development
PUERTO=3001

# Base de datos local (docker-compose.yml, puerto 5434)
URL_BASE_DE_DATOS=postgres://seniory:seniory@localhost:5434/seniory

# Orígenes del frontend permitidos, separados por comas. Sin comodines.
ORIGENES_PERMITIDOS=http://localhost:3000

# error | warn | info | debug | trace  (en producción no se permite debug ni trace)
NIVEL_DE_LOG=info
ZONA_HORARIA_NEGOCIO=America/Bogota

# Cada cuántos milisegundos se buscan eventos pendientes en el outbox (0 a 60000; 0 solo en pruebas)
INTERVALO_SONDEO_OUTBOX_MS=1000

# Opcional en desarrollo; obligatorio en staging y producción (32 caracteres o más).
# Se comparte con el frontend (SENIORY_BFF_SECRETO). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_BFF=

# Con qué se firman los tokens de acceso (32 caracteres o más, distinto de SECRETO_BFF). Obligatorio.
# Genera uno con el mismo comando de arriba. Para rotarlo, cambia también ID_CLAVE_JWT.
SECRETO_JWT_ACCESO=
ID_CLAVE_JWT=k1
DURACION_ACCESO_MIN=15
DURACION_REFRESCO_DIAS=30

# Las cookies de sesión llevan Secure. En local (http://localhost) pon false; en staging y producción
# debe ser true.
COOKIES_SEGURAS=false

# Versión de la política de tratamiento de datos que se pide aceptar al registrarse.
VERSION_POLITICA_VIGENTE=v1
# Versión del texto del consentimiento para tratar datos de salud.
VERSION_CONSENTIMIENTO_SALUD_VIGENTE=v1

# Opcional
SENTRY_DSN=
