# Copia este archivo a .env para desarrollo local: cp .env.ejemplo .env
# .env nunca se sube a git. En staging y producción las variables se configuran en el hosting.

# development | test | staging | production
NODE_ENV=development
PUERTO=3001

# Base de datos local (docker-compose.yml, puerto 5434)
URL_BASE_DE_DATOS=postgres://seniory:seniory@localhost:5434/seniory

# Producción: DOS cuentas. La API usa URL_BASE_DE_DATOS con un rol que solo lee y escribe datos (no crea ni
# borra tablas); las migraciones y los permisos se aplican con la cuenta DUEÑA, en URL_BASE_DE_DATOS_MIGRACIONES.
# Si no se define, las migraciones usan URL_BASE_DE_DATOS (desarrollo). Ver docs/OPERACION.md.
#   npm run bd:migrar && npm run bd:permisos
# URL_BASE_DE_DATOS_MIGRACIONES=postgres://dueno:...@host:5432/seniory
# ROL_DE_APLICACION=seniory_app
# CLAVE_DEL_ROL_DE_APLICACION=            # 16 caracteres o más; es la contraseña del rol en URL_BASE_DE_DATOS

# Clave (32 caracteres o más) del monitor para GET /api/v1/salud/operacion (estado del outbox). Sin ella la ruta no
# existe (404). Se envía en el encabezado X-Seniory-Operacion. Generarla: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SECRETO_DE_OPERACION=

# Orígenes del frontend permitidos, separados por comas. Sin comodines.
ORIGENES_PERMITIDOS=http://localhost:3000

# error | warn | info | debug | trace  (en producción no se permite debug ni trace)
NIVEL_DE_LOG=info
ZONA_HORARIA_NEGOCIO=America/Bogota

# Cada cuántos milisegundos se buscan eventos pendientes en el outbox (0 a 60000; 0 solo en pruebas)
INTERVALO_SONDEO_OUTBOX_MS=1000
# Cada cuánto se cancelan las solicitudes de servicio sin respuesta del cuidador (60000 = cada minuto).
INTERVALO_EXPIRACION_SERVICIOS_MS=60000
# Cada cuánto se envían los avisos pendientes (2000 = cada 2 segundos).
INTERVALO_ENTREGA_NOTIFICACIONES_MS=2000
# Teleasistencia: cuántos minutos después de la hora de una toma se da por omitida (la fija el equipo con un
# profesional de salud) y cada cuánto se revisan las tomas vencidas (60000 = cada minuto).
TOLERANCIA_DE_TOMA_MINUTOS=60
INTERVALO_OMISION_TOMAS_MS=60000
# Finge correo, SMS, WhatsApp y push (solo escribe en el log). SOLO desarrollo: en producción no se admite.
# Mientras no haya proveedores, los avisos salen únicamente por la aplicación (la campana).
CANALES_DE_NOTIFICACION_SIMULADOS=false

# Pagos. PASARELA_DE_PAGOS: simulada (pagos de mentira firmados con SECRETO_DE_PASARELA, solo desarrollo y
# staging), mercadopago (Checkout Pro / API de Orders, admitida en producción) o deshabilitada (cobrar responde
# «no disponible» hasta elegir proveedor). DISPERSOR_DE_PAGOS: simulado o deshabilitado (las liquidaciones al
# cuidador quedan pendientes). En producción no se admiten los simulados.
PASARELA_DE_PAGOS=simulada
# 32 caracteres o más; obligatorio con la pasarela simulada.
SECRETO_DE_PASARELA=

# Credenciales de MercadoPago (obligatorias con PASARELA_DE_PAGOS=mercadopago). El access token está en el
# panel de desarrolladores de la aplicación (pestaña Credenciales); el secreto de firma, en «Configuración de
# webhooks» de esa misma aplicación.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_SECRETO_DE_FIRMA=
DISPERSOR_DE_PAGOS=simulado
# true: un servicio solo inicia con el pago aprobado (obligatorio en staging y producción).
REQUIERE_PAGO_APROBADO=false
# Cuánto tiempo tiene la familia para pagar antes de que el pago venza, y cada cuánto se vencen (60000 = cada
# minuto) y se envían las liquidaciones pendientes al cuidador.
MINUTOS_PARA_PAGAR=120
INTERVALO_EXPIRACION_PAGOS_MS=60000
INTERVALO_LIQUIDACION_MS=60000

# Opcional en desarrollo; obligatorio en staging y producción (32 caracteres o más).
# Se comparte con el frontend (SENIORY_BFF_SECRETO). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETO_BFF=

# Con qué se firman los tokens de acceso (32 caracteres o más, distinto de SECRETO_BFF). Obligatorio.
# Genera uno con el mismo comando de arriba. Para rotarlo, cambia también ID_CLAVE_JWT.
SECRETO_JWT_ACCESO=
ID_CLAVE_JWT=k1
DURACION_ACCESO_MIN=15
DURACION_REFRESCO_DIAS=30

# Las cookies de sesión llevan Secure. En local (http://localhost) pon false; en staging y producción
# debe ser true.
COOKIES_SEGURAS=false

# Versión de la política de tratamiento de datos que se pide aceptar al registrarse.
VERSION_POLITICA_VIGENTE=v1
# Por dónde llega el enlace para recuperar la contraseña: consola (lo escribe en el log del servidor, solo
# para desarrollo), resend (el canal real, admitido en producción) o deshabilitado (la recuperación responde
# «no disponible» hasta que se elija uno).
CANAL_DE_RECUPERACION=consola

# Credenciales de Resend (obligatorias con CANAL_DE_RECUPERACION=resend). La API key se consigue en
# resend.com → API Keys. Sin un dominio propio verificado, RESEND_CORREO_DESDE debe ser
# "Seniory <onboarding@resend.dev>", y solo entrega al correo de la propia cuenta de Resend.
RESEND_API_KEY=
RESEND_CORREO_DESDE=

# Dónde se guardan los archivos de los cuidadores (hoja de vida): local (una carpeta del servidor, solo
# desarrollo y staging), cloudinary (el almacén real, admitido en producción) o deshabilitado (la hoja de
# vida responde «no disponible» hasta que se elija uno).
ALMACEN_DE_ARCHIVOS=local
DIRECTORIO_DE_ARCHIVOS=./archivos-locales
# Firma las direcciones temporales de los archivos (32 caracteres o más; obligatorio con el almacén local).
SECRETO_DE_ARCHIVOS=
# Dirección de la API a la que apuntan esas direcciones; por defecto http://localhost:<PUERTO>/api/v1
URL_PUBLICA_DE_LA_API=

# Credenciales de Cloudinary (obligatorias con ALMACEN_DE_ARCHIVOS=cloudinary). Se consiguen en el Dashboard
# de Cloudinary → Product Environment Credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Versión del texto del consentimiento para tratar datos de salud.
VERSION_CONSENTIMIENTO_SALUD_VIGENTE=v1

# Solo para `npm run semillas` (datos de ejemplo de desarrollo): la contraseña de Andrea. No se guarda en
# el repositorio ni tiene valor por defecto.
CONTRASENA_DE_PRUEBA=

# Opcional
SENTRY_DSN=
