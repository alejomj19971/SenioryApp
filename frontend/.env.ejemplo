# Copia este archivo a .env.local para desarrollo: cp .env.ejemplo .env.local
# .env.local nunca se sube a git. En producción las variables se configuran en Vercel.
# Ninguna lleva NEXT_PUBLIC_: no deben llegar al navegador.

# Dirección de la API del backend, con su prefijo (docs/backend, M0).
SENIORY_API_URL=http://localhost:3001/api/v1

# Secreto compartido con el backend: debe ser IGUAL a SECRETO_BFF de backend/.env (32 caracteres o más).
# Con él, el backend usa la IP real del navegador para sus límites de peticiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENIORY_BFF_SECRETO=

# Solo para las pruebas de contrato y de recorrido (nunca en producción): una cuenta de administrador LOCAL para que
# las pruebas creen cuidadores verificados por el flujo real. Se crea con `npm run crear-admin` en backend/. Sin ella,
# las pruebas que la necesitan se omiten con un mensaje claro.
# ADMIN_DE_PRUEBA_CORREO=
# ADMIN_DE_PRUEBA_CONTRASENA=
# Solo pruebas: el secreto con que la pasarela SIMULADA firma sus avisos (igual a SECRETO_DE_PASARELA del backend). La
# simulada no tiene página de pago: un pago solo pasa a aprobado con un aviso firmado, que las pruebas fabrican con esto.
# SECRETO_DE_PASARELA_DE_PRUEBA=
