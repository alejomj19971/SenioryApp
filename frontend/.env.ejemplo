# Copia este archivo a .env.local para desarrollo: cp .env.ejemplo .env.local
# .env.local nunca se sube a git. En producción las variables se configuran en Vercel.
# Ninguna lleva NEXT_PUBLIC_: no deben llegar al navegador.

# Dirección de la API del backend, con su prefijo (docs/backend, M0).
SENIORY_API_URL=http://localhost:3001/api/v1

# Secreto compartido con el backend: debe ser IGUAL a SECRETO_BFF de backend/.env (32 caracteres o más).
# Con él, el backend usa la IP real del navegador para sus límites de peticiones. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SENIORY_BFF_SECRETO=
